# Copy to .env and set your own passwords. .env is ignored by Git.
DB_URL=jdbc:mysql://localhost:3306/doa?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=doa
DB_PASSWORD=replace-with-your-own-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
PORT=8080
PUBLIC_URL=http://localhost:8080
# Account recovery requires a working SMTP server.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@localhost
COOKIE_SECURE=false
